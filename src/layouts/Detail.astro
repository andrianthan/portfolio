---
import Base from './Base.astro';

interface Link { label: string; href: string; primary?: boolean }
interface Nav { href: string; label: string }
interface Props {
  kicker: string; title: string; lede: string;
  meta: { label: string; value: string }[];
  links: Link[];
  prev: Nav | null; next: Nav | null;
  backHref: string; backLabel: string;
  shot?: string; shotAlt?: string; noShot?: boolean;
}
const { kicker, title, lede, meta, links, prev, next, backHref, backLabel, shot, shotAlt, noShot } = Astro.props;
---
<Base title={`${title} · Andrian Than`} description={lede}>
  <div class="detail">
    <div class="wide"><header class="bar"><a href={backHref}>← {backLabel}</a></header></div>
    <main class="inner">
      <header class="ph">
        <p class="kicker">{kicker}</p>
        <h1>{title}</h1>
        <p class="lede">{lede}</p>
        <dl class="meta">
          {meta.map((m) => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}
        </dl>
        {links.length > 0 && (
          <div class="links">
            {links.map((l) => <a class={l.primary ? 'p' : undefined} href={l.href}>{l.label}</a>)}
          </div>
        )}
      </header>

      <slot name="toc" />

      {noShot
        ? null
        : shot
          ? <img class="shot-img" src={shot} alt={shotAlt ?? ''} width="1280" height="720" loading="lazy" />
          : <div class="shot">screenshot</div>}

      <div class="prose"><slot /></div>

      <nav class="next" aria-label="More">
        {prev ? <a href={prev.href}><small>Previous</small>← {prev.label}</a> : <span></span>}
        {next ? <a href={next.href} style="text-align:right"><small>Next</small>{next.label} →</a> : <span></span>}
      </nav>
    </main>
  </div>
</Base>
