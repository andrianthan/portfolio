---
import { swimEvents, swimPercentileLine, swimContextLine } from '../data/swimming';
---
<div class="lifting swimming reveal">
  <header class="lifting-head"><p class="eyebrow">In the pool</p><h3>Swimming</h3></header>
  <ul class="lifting-stats swimming-stats">
    {swimEvents.map((e) => <li><b>{e.time}</b><span>{e.name}</span></li>)}
  </ul>
  <p class="lifting-pct">{swimPercentileLine}</p>
  <p class="swimming-context">{swimContextLine}</p>
</div>
