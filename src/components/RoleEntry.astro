---
import type { CollectionEntry } from 'astro:content';
import { renderBold } from '../lib/content';
interface Props { role: CollectionEntry<'work'>; hasPage: boolean }
const { role, hasPage } = Astro.props;
const d = role.data;
---
<article class:list={['job', { now: d.current }, 'reveal']}>
  <div class={`logo${d.logoFill ? ' fill' : ''}`}><img src={d.logo} alt={d.company} width="48" height="48" /></div>
  <div>
    <h3>{d.title} <span class="org">· {d.company}</span>{d.current && <span class="tag">current</span>}</h3>
    <p class="dates">{`${d.dates} · ${d.project}`.toUpperCase()}</p>
    <p set:html={renderBold(d.summary)} />
    <ul class="stack">{d.stack.map((s) => <li>{s}</li>)}</ul>
    {hasPage && <a class="more" href={`/work/${role.id}`}>Read the full write-up <span>→</span></a>}
  </div>
</article>
