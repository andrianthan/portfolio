---
import { profile } from '../data/profile';
import Lifting from './Lifting.astro';
---
<section class="s" id="about">
  <header class="sh"><p class="eyebrow">Get to know me</p><h2>About</h2></header>
  <div class="about reveal">
    <img src="/headshot.jpg" alt="" width="170" height="210" />
    <div>
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
  <Lifting />
</section>
