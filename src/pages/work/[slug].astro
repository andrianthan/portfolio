---
import { getCollection, render } from 'astro:content';
import Detail from '../../layouts/Detail.astro';
import { cleared, neighbors } from '../../lib/content';
import QaDemo from '../../components/qa/QaDemo';
import ImageSearchDemo from '../../components/imgsearch/ImageSearchDemo';
import GrantsDemo from '../../components/hanna/grants/GrantsDemo';
import IrDemo from '../../components/hanna/ir/IrDemo';
import NoteCoachDemo from '../../components/hanna/notes/NoteCoachDemo';
import GuideDemo from '../../components/guide/GuideDemo';
import DashboardDemo from '../../components/tesla/dashboard/DashboardDemo';
import PartSummaryDemo from '../../components/tesla/partsummary/PartSummaryDemo';
import AskSdpDemo from '../../components/tesla/asksdp/AskSdpDemo';
import ForecastLabDemo from '../../components/tesla/forecastlab/ForecastLabDemo';
import CampaignsDemo from '../../components/tesla/campaigns/CampaignsDemo';
import SlidesDemo from '../../components/tesla/slides/SlidesDemo';
import ModularDemo from '../../components/tesla/modular/ModularDemo';
import AdminDemo from '../../components/tesla/admin/AdminDemo';
import '../../styles/projects.css';

export async function getStaticPaths() {
  const all = cleared(await getCollection('work'));
  return all.map((entry) => {
    const { prev, next } = neighbors(all, entry.id);
    return { params: { slug: entry.id }, props: { entry, prev, next } };
  });
}

// Pages that hold several projects: each `##` heading is a project, and its demo (if any)
// renders right after the project's first paragraph.
// Demos are matched by heading id prefix. Astro needs static component references to hydrate.
const MULTI = new Set(['bluedome', 'hanna', 'tesla']);

type Demo = 'qa' | 'img' | 'grants' | 'ir' | 'notes' | 'guide' | 'dashboard' | 'part' | 'ask' | 'forecast' | 'campaigns' | 'slides' | 'modular' | 'admin';

// Which demo a project renders, if any. The page's mock-data note uses the same
// lookup, so a page that shows a demo always carries the note.
function demoFor(id: string): Demo | null {
  if (id.startsWith('qa-analyst')) return 'qa';
  if (id.startsWith('image-search')) return 'img';
  if (id.startsWith('grants-agent')) return 'grants';
  if (id.startsWith('ir-updater')) return 'ir';
  if (id.startsWith('case-note-coach')) return 'notes';
  if (id.startsWith('guideline-chatbot')) return 'guide';
  if (id.startsWith('dashboard')) return 'dashboard';
  if (id.startsWith('part-summary')) return 'part';
  if (id.startsWith('ask-sdp')) return 'ask';
  if (id.startsWith('forecast-lab')) return 'forecast';
  if (id.startsWith('campaigns')) return 'campaigns';
  if (id.startsWith('slideshow-generation')) return 'slides';
  if (id.startsWith('modular-architecture')) return 'modular';
  if (id.startsWith('admin')) return 'admin';
  return null;
}

// The demo the template's switch has no case for. Its parameter is typed never,
// so a demo that no case handles is a type error, not an empty demo slot.
function unhandledDemo(_demo: never): null {
  return null;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const multi = MULTI.has(entry.id);
interface Project { id: string; title: string; head: string; intro: string; rest: string; demo: Demo | null }
const projects: Project[] = [];
if (multi) {
  const html = entry.rendered?.html ?? '';
  for (const chunk of html.split(/(?=<h2[ >])/).filter((c) => c.trim().startsWith('<h2'))) {
    const m = chunk.match(/^<h2[^>]*id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/);
    if (!m) continue;
    const after = chunk.slice(m[0].length);
    const split = after.search(/<h3[ >]/);
    projects.push({
      id: m[1],
      title: m[2].replace(/<[^>]+>/g, ''),
      head: m[0],
      intro: split === -1 ? after : after.slice(0, split),
      rest: split === -1 ? '' : after.slice(split),
      demo: demoFor(m[1]),
    });
  }
}

// A page that shows a demo carries the mock-data note; a page without one does not.
const hasDemos = projects.some((p) => p.demo !== null);
---
<Detail
  kicker={`Role · ${d.project}`}
  title={d.company}
  lede={`${d.title}, ${d.dates}`}
  meta={[{ label: 'Role', value: d.title }, { label: 'Dates', value: d.dates }, { label: 'Stack', value: d.stack.join(', ') }]}
  links={[]}
  prev={prev ? { href: `/work/${prev.id}`, label: prev.data.company } : null}
  next={next ? { href: `/work/${next.id}`, label: next.data.company } : null}
  backHref="/#experience"
  backLabel="experience"
  noShot={multi}
>
  {/* The note goes in the toc slot because the prose slot sits below the
      project index, so a note placed there would land after the TOC instead of
      before it. */}
  <Fragment slot="toc">
    {hasDemos && (
      <div class="demo-note">
        <p class="eyebrow">Sample data</p>
        <p class="demo-note-text">The demos on this page run on mock data, not real records. The tools they show are internal, so there is nothing to sign up for.</p>
      </div>
    )}
    {multi && projects.length > 1 && (
      <nav class="toc" aria-label="Projects on this page">
        <p class="toc-label">Projects</p>
        <ol>
          {projects.map((p, i) => (
            <li><a href={`#${p.id}`}><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="t">{p.title}</span><span class="go" aria-hidden="true">↓</span></a></li>
          ))}
        </ol>
      </nav>
    )}
  </Fragment>
  {multi
    ? projects.map((p, i) => {
        const demo = p.demo;
        return (
          <section class="project" id={p.id} aria-labelledby={`${p.id}-h`}>
            <h2 id={`${p.id}-h`}><span class="n">{String(i + 1).padStart(2, '0')}</span>{p.title}</h2>
            <Fragment set:html={p.intro} />
            {demo && (
              <div class="demo-slot">
                {/* A switch with a never-typed default: a demo no case handles is
                    a type error, not an empty demo slot. The component references
                    have to stay literal here, because Astro can only hydrate a
                    component it can see the import of. */}
                {(() => {
                  switch (demo) {
                    case 'qa': return <QaDemo client:visible />;
                    case 'img': return <ImageSearchDemo client:visible />;
                    case 'grants': return <GrantsDemo client:visible />;
                    case 'ir': return <IrDemo client:visible />;
                    case 'notes': return <NoteCoachDemo client:visible />;
                    case 'guide': return <GuideDemo client:visible />;
                    case 'dashboard': return <DashboardDemo client:visible />;
                    case 'part': return <PartSummaryDemo client:visible />;
                    case 'ask': return <AskSdpDemo client:visible />;
                    case 'forecast': return <ForecastLabDemo client:visible />;
                    case 'campaigns': return <CampaignsDemo client:visible />;
                    case 'slides': return <SlidesDemo client:visible />;
                    case 'modular': return <ModularDemo client:visible />;
                    case 'admin': return <AdminDemo client:visible />;
                    default: return unhandledDemo(demo);
                  }
                })()}
                <noscript><p>Interactive sample (needs JavaScript).</p></noscript>
              </div>
            )}
            <Fragment set:html={p.rest} />
          </section>
        );
      })
    : <Content />}
</Detail>
